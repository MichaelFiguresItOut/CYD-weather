# PlatformIO build artifacts (regenerable: pio run)
.pio/
compile_commands.json

# Local configuration (never commit real credentials or site location)
src/local_config.h

# Python
__pycache__/
*.pyc

# Scratch / working files (debug photos, frame extracts, serial captures)
frames50/
swipe test pics/
tmp_*.png
test/*.png
test/*.jpg
test/*.txt

# Scratch folder (images/notes handed to the agent for review; never synced)
scratch-folder/

# Local serial captures (test/capture_boot.py / device monitor output)
logs/

# Manual file backups (superseded by git history)
*.bak-*

# Agent notes / internal planning docs (local only, never synced)
/AGENTS.md
docs/FIRMWARE_REFACTOR_SPEC.md

# Theme design mockups (historical artifacts — themes are final; kept local only)
mockups/

# Local-only diagnostics (hardcoded machine paths, not portable)
test/check_sd_card.ps1
